font-family = "FiraCode Nerd Font"
font-size = 15
font-style = "semibold"
theme = "Gruvbox Dark"
cursor-style = block
shell-integration = zsh
shell-integration-features = no-cursor
macos-option-as-alt = left
copy-on-select = clipboard
scrollback-limit = 1000000
keybind = ctrl+n=new_window
keybind = ctrl+b>c=new_tab
keybind = ctrl+b>left=goto_split:left
keybind = ctrl+b>down=goto_split:bottom
keybind = ctrl+b>up=goto_split:top
keybind = ctrl+b>right=goto_split:right
keybind = ctrl+b>shift+5=new_split:left
keybind = ctrl+b>shift+'=new_split:down
keybind = ctrl+b>k=new_split:up
keybind = ctrl+b>l=new_split:right
keybind = ctrl+b>f=toggle_split_zoom
keybind = ctrl+b>n=next_tab
keybind = ctrl+b>p=previous_tab
keybind = super+r=reload_config
window-save-state = always


